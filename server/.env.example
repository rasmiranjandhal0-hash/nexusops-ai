PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Authentication
JWT_SECRET=nexusops_enterprise_secret_super_secure_key_2026_change_in_production

# Google Gemini AI (Server-Side Only - Never expose to client)
GEMINI_API_KEY=your_google_ai_studio_gemini_api_key

# PostgreSQL / Supabase Cloud Connection
# Provide DATABASE_URL (Transaction/Session Pooler or Direct URI from Supabase / Neon / Railway / Replit)
DATABASE_URL=postgresql://postgres:your_password@db.your-project-ref.supabase.co:5432/postgres
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
