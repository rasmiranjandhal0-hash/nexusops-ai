# Server Network Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# Frontend Origin for CORS (e.g. https://your-app.vercel.app or * for all)
FRONTEND_URL=https://your-frontend.vercel.app

# Google Gemini AI Model Configuration (Server-Side Only - Set in Render Dashboard)
# 1. GEMINI_API_KEY: Your API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=AIzaSy_YOUR_REAL_API_KEY_HERE

# 2. GEMINI_MODEL: Model identifier. Options include:
#    - gemini-2.0-flash     (Recommended: Ultra-fast, latest Gemini 2.0 Flash)
#    - gemini-1.5-flash     (Standard high-speed 1.5 Flash)
#    - gemini-1.5-flash-8b  (Lightweight 8-billion parameter Flash model)
#    - gemini-1.5-pro       (High-reasoning Pro model)
GEMINI_MODEL=gemini-2.0-flash

# Optional Database Configuration (for future Supabase PostgreSQL persistence)
DATABASE_URL=
