# Server Network Configuration
PORT=5000
HOST=0.0.0.0
NODE_ENV=production

# Frontend Origin for CORS (e.g. https://your-app.vercel.app or * for all)
FRONTEND_URL=https://your-frontend.vercel.app

# Optional Database Configuration (for future Supabase PostgreSQL persistence)
# Not required for current zero-persistence heuristic inspection
DATABASE_URL=postgresql://postgres:password@db.your-ref.supabase.co:5432/postgres

# Server-side AI API Key (Server-Side Only - Never expose to client)
AI_API_KEY=
